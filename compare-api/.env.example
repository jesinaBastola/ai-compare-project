# Copy this file to .env and fill in real values.

# REQUIRED (unless USE_MOCK_DATA=true below): URL of the Tool Profile API -
# the single source of truth for tool data. This service should NOT be
# skipped in production; the Compare API only aggregates/compares, it does
# not own or store tool data itself.
# Example: http://localhost:4000/api/tools  (expects GET {this}/{slug})
TOOL_PROFILE_API_URL=

# OPTIONAL, for local testing only - set to "true" to use local mock data
# (data/tools.js) instead of calling the real Tool Profile API. Do NOT use
# this in production; remove/unset it once TOOL_PROFILE_API_URL is real.
USE_MOCK_DATA=

# Anthropic API key for real AI-generated comparison sections.
# Leave blank to use the built-in mock generator instead.
ANTHROPIC_API_KEY=
